QQ_BOT_HOST=127.0.0.1
QQ_BOT_PORT=3100
QQ_BOT_SELF_ID=123456789
QQ_BOT_DB=./data/qq-bot.sqlite
QQ_BOT_GROUPS=./bot/groups.json
# 启用管理界面后，通过网页配置服务器和群；下方 WARCON_* 与 groups.json 不再必填。
QQ_BOT_MANAGED=true
QQ_ADMIN_USER=admin
QQ_ADMIN_PASSWORD=
# HTTPS 反代时填写浏览器访问的固定来源（如 https://bot.example.com，无 /admin）；留空用于直接 HTTP 访问。
QQ_ADMIN_ORIGIN=
# openssl rand -base64 32；请独立备份此主密钥。
QQ_BOT_MASTER_KEY=
# NapCat HTTP 客户端的 token，用来校验 X-Signature；用随机长密钥替换。
NAPCAT_WEBHOOK_SECRET=
# NapCat HTTP 服务端地址与 token。
NAPCAT_API_URL=http://127.0.0.1:3000
NAPCAT_API_TOKEN=
WARCON_URL=http://127.0.0.1:5173
# 仅授权目标服务器：server.view、chat.send、players.move
WARCON_API_TOKEN=
